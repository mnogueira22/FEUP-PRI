{
	"add-field-type": [
        {
            "name":"text",
            "class":"solr.TextField",
            "indexAnalyzer":{
                "tokenizer":{
                    "class":"solr.ClassicTokenizerFactory"
                },
                "filters":[
                    {"class":"solr.ASCIIFoldingFilterFactory", "preserveOriginal":true},
                    {"class":"solr.LowerCaseFilterFactory"},
                    {"class":"solr.EnglishMinimalStemFilterFactory"}
                ]
            },
            "queryAnalyzer":{
                "tokenizer":{
                    "class":"solr.ClassicTokenizerFactory"
                },
                "filters":[
                    {"class":"solr.ASCIIFoldingFilterFactory", "preserveOriginal":true},
                    {"class":"solr.LowerCaseFilterFactory"},
                    {"class":"solr.EnglishMinimalStemFilterFactory"}
                ]
            }
        },
        {
            "name":"array",
            "class":"solr.TextField",
            "indexAnalyzer":{
                "tokenizer":{
                    "class":"solr.KeywordTokenizerFactory"
                },
                "filters":[
                    {"class":"solr.ASCIIFoldingFilterFactory", "preserveOriginal":true},
                    {"class":"solr.LowerCaseFilterFactory"},
                ]
            },
            "queryAnalyzer":{
                "tokenizer":{
                    "class":"solr.KeywordTokenizerFactory"
                },
                "filters":[
                    {"class":"solr.ASCIIFoldingFilterFactory", "preserveOriginal":true},
                    {"class":"solr.LowerCaseFilterFactory"},
                ]
            }
        }
    ],
    "add-field": [
        {
            "name": "round",
            "type": "pint"
        },
        {
            "name": "date",
            "type": "pdate"
        },
        {
            "name": "circuit",
            "type": "text"
        },
        {
            "name": "country",
            "type": "text"
        },
        {
            "name": "location",
            "type": "text"
        },
        {
            "name": "weather_ condition",
            "type": "text"
        },
        {
            "name": "summary",
            "type": "text"
        },
        {
            "name": "drivers",
            "type": "array",
            "multiValued": true
        }
    ]
}
