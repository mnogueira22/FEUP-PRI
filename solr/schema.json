{
    "add-field-type": [
        {
            "name": "text",
            "class": "solr.TextField",
            "indexAnalyzer": {
                "tokenizer": {
                    "class": "solr.ClassicTokenizerFactory"
                },
                "filters": [
                    {"class": "solr.ASCIIFoldingFilterFactory", "preserveOriginal": true},
                    {"class": "solr.LowerCaseFilterFactory"},
                    {"class": "solr.StopFilterFactory", "words": "stopwords.txt", "ignoreCase": true},
                    {"class": "solr.EnglishMinimalStemFilterFactory"}
                ]
            },
            "queryAnalyzer": {
                "tokenizer": {
                    "class": "solr.ClassicTokenizerFactory"
                },
                "filters": [
                    {"class": "solr.ASCIIFoldingFilterFactory", "preserveOriginal": true},
                    {"class": "solr.LowerCaseFilterFactory"},
                    {"class": "solr.StopFilterFactory", "words": "stopwords.txt", "ignoreCase": true},
                    {"class": "solr.EnglishMinimalStemFilterFactory"}
                ]
            }
        },
        {
            "name": "array",
            "class": "solr.TextField",
            "indexAnalyzer": {
                "tokenizer": {
                    "class": "solr.ClassicTokenizerFactory"
                },
                "filters": [
                    {"class": "solr.ASCIIFoldingFilterFactory", "preserveOriginal": true},
                    {"class": "solr.LowerCaseFilterFactory"}
                ]
            },
            "queryAnalyzer": {
                "tokenizer": {
                    "class": "solr.ClassicTokenizerFactory"
                },
                "filters": [
                    {"class": "solr.ASCIIFoldingFilterFactory", "preserveOriginal": true},
                    {"class": "solr.LowerCaseFilterFactory"}
                ]
            }
        }
    ],
    "add-field": [
        {
            "name": "name",
            "type": "text",
            "stored": true,
            "indexed": true
        },
        {
            "name": "round",
            "type": "pint",
            "stored": true,
            "indexed": true
        },
        {
            "name": "date",
            "type": "pdate",
            "stored": true,
            "indexed": true
        },
        {
            "name": "circuit",
            "type": "text",
            "stored": true,
            "indexed": true
        },
        {
            "name": "country",
            "type": "text",
            "stored": true,
            "indexed": true
        },
        {
            "name": "location",
            "type": "text",
            "stored": true,
            "indexed": true
        },
        {
            "name": "weather_condition",
            "type": "text",
            "stored": true,
            "indexed": true
        },
        {
            "name": "summary",
            "type": "text",
            "stored": true,
            "indexed": true
        },
        {
            "name": "drivers",
            "type": "array",
            "stored": true,
